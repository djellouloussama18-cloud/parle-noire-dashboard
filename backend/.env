PORT=3001
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h
# AI Assistant يعمل محلياً، لا حاجة لمفتاح API
DB_PATH=./database/pos_store.db
BACKUP_PATH=./backups
NODE_ENV=development

# SMTP Email Configuration (Gmail App Password)
# For Gmail: enable 2FA, generate App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_16_chars
MAIL_FROM="Parle Noire POS" <noreply@parlenoire.store>
