# ── Parle Noire POS — Sync from Supabase ──
# Copy this file to .env.sync and fill in your values.
#
# Usage:
#   node backend/scripts/sync-from-supabase.js
#
# SUPABASE_URL     (required)  Your Supabase project URL
# SUPABASE_SERVICE_KEY  (required)  Your Supabase service_role key
# SYNC_LICENSE_CODE  (optional)  License code to identify the client.
#                                Default: PN-2T7Q-7WVE-9BC4
# SYNC_DRY_RUN       (optional)  Set to "1" for dry run (simulate only),
#                                "0" to apply changes. Default: 0

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SYNC_LICENSE_CODE=PN-2T7Q-7WVE-9BC4
SYNC_DRY_RUN=1
